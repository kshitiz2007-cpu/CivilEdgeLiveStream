# ---- Frontend (public, safe for client bundle) ----
# Supabase Project Settings -> API. Leave empty to run in local Sandbox Mode.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# ---- Server only (NEVER prefix with VITE_) ----
# Supabase service role key enables verified server-side writes for AI Mains scores.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Server-side Gemini API key for UPSC Mains answer evaluation.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# ---- Database Verification Tooling ----
# Used by `npm run schema:check` (Supabase -> Project Settings -> Database -> Connection string)
DATABASE_URL=""
PORT=3000
